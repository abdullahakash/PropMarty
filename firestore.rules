rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // Keep in sync with ADMIN_EMAILS in the app. Add more with: in ['a@x.com','b@x.com']
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['abdullahakash940@gmail.com'];
    }
    function isOwner() {
      return resource.data.get('ownerId', null) == request.auth.uid;
    }

    match /flats/{flatId} {
      allow read, delete: if isSignedIn() && (isOwner() || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn() && (
        (isOwner() && request.resource.data.ownerId == request.auth.uid)
        || (isAdmin() && (!('ownerId' in resource.data)
                          || request.resource.data.ownerId == resource.data.ownerId))
      );
    }
  }
}
